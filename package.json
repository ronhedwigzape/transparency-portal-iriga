{
  "name": "transparency-portals-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Monorepo of FY2027 budget transparency portals for Iriga City, Camarines Sur, and DPWH CamSur 5th DEO.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:iriga": "npm run dev --workspace=transparency-portal-iriga",
    "dev:camsur": "npm run dev --workspace=transparency-portal-camsur",
    "dev:dpwh": "npm run dev --workspace=transparency-portal-dpwh-camsur-district-5",
    "build": "npm run build --workspaces",
    "build:iriga": "npm run build --workspace=transparency-portal-iriga",
    "build:camsur": "npm run build --workspace=transparency-portal-camsur",
    "build:dpwh": "npm run build --workspace=transparency-portal-dpwh-camsur-district-5",
    "check": "npm run check --workspaces",
    "check:iriga": "npm run check --workspace=transparency-portal-iriga",
    "check:camsur": "npm run check --workspace=transparency-portal-camsur",
    "check:dpwh": "npm run check --workspace=transparency-portal-dpwh-camsur-district-5",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
